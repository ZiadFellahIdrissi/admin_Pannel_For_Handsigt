<%- include('../partials/head', { title: 'Candidates' }) %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar', { title: 'Candidates' }) %>
    <%- include('../partials/flash') %>
    <div class="max-w-6xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
  <div class="flex items-center justify-between flex-wrap gap-3 mb-4 sm:mb-6">
    <h1 class="text-lg sm:text-xl font-bold flex items-center gap-3">
      <div class="icon-circle-accent"><i class="fa-solid fa-address-card"></i></div>
      Candidates
    </h1>
    <a href="/candidates/new" class="btn-primary">
      <i class="fa-solid fa-user-plus"></i>Add Candidate
    </a>
  </div>

  <form action="/candidates/ai-search" method="POST" class="card p-4 mb-4 flex flex-col sm:flex-row gap-3 sm:items-end" data-prevent-double-submit>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="flex-1">
      <label class="field-label" for="ai-prompt"><i class="fa-solid fa-wand-magic-sparkles text-brand-accent"></i> Describe who you're looking for</label>
      <input class="field-input" type="text" id="ai-prompt" name="prompt" placeholder="e.g. freelance data engineer in Casablanca, open to CDI, rating 4+">
    </div>
    <button type="submit" class="btn-primary"><i class="fa-solid fa-magnifying-glass"></i>AI Search</button>
  </form>

  <form action="/candidates" method="GET" class="card p-4 mb-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-7 gap-3 items-end">
      <div class="sm:col-span-2 lg:col-span-2">
        <label class="field-label" for="q">Search</label>
        <input class="field-input" type="text" id="q" name="q" placeholder="Name or email..." value="<%= q %>">
      </div>
      <div>
        <label class="field-label" for="position">Role</label>
        <input class="field-input" type="text" id="position" name="position" placeholder="Developer..." value="<%= position %>">
      </div>
      <div>
        <label class="field-label" for="skills">Skills</label>
        <input class="field-input" type="text" id="skills" name="skills" placeholder="SQL..." value="<%= skills %>">
      </div>
      <div>
        <label class="field-label" for="city">City</label>
        <input class="field-input" type="text" id="city" name="city" placeholder="Casablanca..." value="<%= city %>">
      </div>
      <div>
        <label class="field-label" for="minExperience">Min. experience (yrs)</label>
        <input class="field-input" type="number" step="0.5" min="0" id="minExperience" name="minExperience" value="<%= minExperience %>">
      </div>
      <div>
        <label class="field-label" for="status">Status</label>
        <select class="field-input" id="status" name="status">
          <option value="">All</option>
          <% statuses.forEach(function(s) { %>
            <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= statusLabels[s] %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <button type="button" data-collapse-toggle="advanced-filters" aria-expanded="<%= hasAdvancedFilters ? 'true' : 'false' %>" class="btn-secondary text-sm mt-3">
      <i class="fa-solid fa-chevron-down transition-transform <%= hasAdvancedFilters ? 'rotate-180' : '' %>" data-collapse-icon></i>
      Advanced filters
    </button>

    <div id="advanced-filters" class="<%= hasAdvancedFilters ? '' : 'hidden' %> grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-7 gap-3 items-end mt-3 pt-3 border-t border-brand-borderLight">
      <div>
        <label class="field-label" for="country">Country</label>
        <input class="field-input" type="text" id="country" name="country" placeholder="Morocco..." value="<%= country %>">
      </div>
      <div>
        <label class="field-label" for="gender">Gender</label>
        <select class="field-input" id="gender" name="gender">
          <option value="">All</option>
          <% genders.forEach(function(g) { %>
            <option value="<%= g %>" <%= gender === g ? 'selected' : '' %>><%= g.charAt(0).toUpperCase() + g.slice(1) %></option>
          <% }); %>
        </select>
      </div>
      <div>
        <label class="field-label" for="educationLevel">Education level</label>
        <select class="field-input" id="educationLevel" name="educationLevel">
          <option value="">All</option>
          <% educationLevels.forEach(function(lvl) { %>
            <option value="<%= lvl %>" <%= educationLevel === lvl ? 'selected' : '' %>><%= lvl %></option>
          <% }); %>
        </select>
      </div>
      <div>
        <label class="field-label" for="specialty">Specialty</label>
        <input class="field-input" type="text" id="specialty" name="specialty" placeholder="Data Engineering..." value="<%= specialty %>">
      </div>
      <div>
        <label class="field-label" for="certifications">Certifications</label>
        <input class="field-input" type="text" id="certifications" name="certifications" placeholder="AWS..." value="<%= certifications %>">
      </div>
      <div>
        <label class="field-label" for="languages">Languages</label>
        <input class="field-input" type="text" id="languages" name="languages" placeholder="English..." value="<%= languages %>">
      </div>
      <div>
        <label class="field-label" for="availability">Availability</label>
        <input class="field-input" type="text" id="availability" name="availability" placeholder="Immediate..." value="<%= availability %>">
      </div>

      <div>
        <label class="field-label" for="source">Source</label>
        <input class="field-input" type="text" id="source" name="source" placeholder="LinkedIn..." value="<%= source %>">
      </div>
      <div>
        <label class="field-label" for="minRating">Min. rating</label>
        <select class="field-input" id="minRating" name="minRating">
          <option value="">Any</option>
          <% [1, 2, 3, 4, 5].forEach(function(r) { %>
            <option value="<%= r %>" <%= String(minRating) === String(r) ? 'selected' : '' %>><%= r %>+</option>
          <% }); %>
        </select>
      </div>
      <div>
        <label class="field-label" for="maxSalary">Max. expected salary</label>
        <input class="field-input" type="number" step="1" min="0" id="maxSalary" name="maxSalary" value="<%= maxSalary %>">
      </div>
      <div>
        <label class="field-label" for="maxTjm">Max. expected TJM</label>
        <input class="field-input" type="number" step="1" min="0" id="maxTjm" name="maxTjm" value="<%= maxTjm %>">
      </div>
      <div class="sm:col-span-2 lg:col-span-3">
        <label class="field-label">Open to</label>
        <div class="flex items-center gap-4 h-[42px]">
          <label class="flex items-center gap-1.5 text-sm cursor-pointer">
            <input type="checkbox" name="openToCdd" <%= openToCdd ? 'checked' : '' %> class="rounded w-4 h-4">CDD
          </label>
          <label class="flex items-center gap-1.5 text-sm cursor-pointer">
            <input type="checkbox" name="openToCdi" <%= openToCdi ? 'checked' : '' %> class="rounded w-4 h-4">CDI
          </label>
          <label class="flex items-center gap-1.5 text-sm cursor-pointer">
            <input type="checkbox" name="openToFreelance" <%= openToFreelance ? 'checked' : '' %> class="rounded w-4 h-4">Freelance
          </label>
        </div>
      </div>
    </div>

    <button type="submit" class="btn-primary w-full mt-3"><i class="fa-solid fa-filter"></i>Filter</button>
  </form>

  <% if (candidates.length === 0) { %>
    <div class="card p-8 text-center">
      <i class="fa-regular fa-folder-open text-2xl text-brand-gray2 mb-2"></i>
      <p class="text-sm text-brand-gray2">No candidates found.</p>
    </div>
  <% } else { %>
    <form action="/candidates/bulk-delete" method="POST" data-confirm="Delete the selected candidates? This can't be undone.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-16">
        <% candidates.forEach(function(c) { %>
          <div class="card-interactive p-4 relative">
            <input type="checkbox" name="candidateIds" value="<%= c.id %>" data-bulk-select-item="candidates-list" class="absolute top-3 right-3 rounded z-10 w-4 h-4">
            <a href="/candidates/<%= c.id %>" class="block pr-6">
              <div class="flex items-start gap-3 mb-3">
                <div class="icon-circle-slate font-bold shrink-0"><%= (c.first_name.charAt(0) + c.last_name.charAt(0)).toUpperCase() %></div>
                <div class="min-w-0">
                  <div class="font-semibold truncate"><%= c.first_name %> <%= c.last_name %></div>
                  <div class="text-xs text-brand-gray2 truncate"><%= c.possible_roles || '—' %></div>
                </div>
                <span class="<%= statusBadgeClass[c.status] %> ml-auto shrink-0"><%= statusLabels[c.status] %></span>
              </div>
              <div class="text-xs text-brand-gray2 space-y-1">
                <% var exp = yearsSince(c.first_experience_date); %>
                <% if (exp !== null) { %>
                  <div><i class="fa-solid fa-briefcase w-4 text-center"></i> <%= exp %> yrs experience</div>
                <% } %>
                <% if (c.email) { %>
                  <div class="truncate"><i class="fa-solid fa-envelope w-4 text-center"></i> <%= c.email %></div>
                <% } %>
                <% if (c.phone) { %>
                  <div><i class="fa-solid fa-phone w-4 text-center"></i> <%= c.phone %></div>
                <% } %>
                <% if (c.city || c.country) { %>
                  <div><i class="fa-solid fa-location-dot w-4 text-center"></i> <%= [c.city, c.country].filter(Boolean).join(', ') %></div>
                <% } %>
              </div>
            </a>
          </div>
        <% }); %>
      </div>

      <div data-bulk-select-bar="candidates-list" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-20 card px-4 py-3 shadow-xl flex items-center gap-3" style="display: none;">
        <span class="text-sm font-medium"><span data-bulk-select-count>0</span> selected</span>
        <button type="submit" class="btn-danger text-sm !px-3 !py-1.5"><i class="fa-solid fa-trash"></i>Delete Selected</button>
      </div>
    </form>
  <% } %>
    </div>
  </div>
</div>
<script src="/js/confirm-submit.js?v=<%= assetVersion %>" defer></script>
<script src="/js/bulk-select.js?v=<%= assetVersion %>" defer></script>
<script src="/js/collapse-toggle.js?v=<%= assetVersion %>" defer></script>
<script src="/js/prevent-double-submit.js?v=<%= assetVersion %>" defer></script>

<%- include('../partials/foot') %>
