<%- include('../partials/head', { title: offerRow.title }) %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar', { title: offerRow.title }) %>
    <%- include('../partials/flash') %>
    <div class="max-w-3xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
  <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-lg sm:text-xl font-bold flex items-center gap-3">
      <div class="icon-circle-accent"><i class="fa-solid fa-briefcase"></i></div>
      <span>
        <%= offerRow.title %>
        <span class="ml-2 <%= offerRow.status === 'published' ? 'badge-approved' : 'badge-draft' %>"><%= offerRow.status === 'published' ? 'Published' : 'Draft' %></span>
      </span>
    </h1>
    <div class="flex items-center gap-2">
      <form action="/career-offers/<%= offerRow.id %>/toggle-status" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn-secondary"><%= offerRow.status === 'published' ? 'Unpublish' : 'Publish' %></button>
      </form>
      <a href="/career-offers/<%= offerRow.id %>/edit" class="btn-secondary">
        <i class="fa-solid fa-pen"></i>Edit
      </a>
      <form action="/career-offers/<%= offerRow.id %>/delete" method="POST" data-confirm="Delete &quot;<%= offerRow.title %>&quot;? This can't be undone.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn-danger"><i class="fa-solid fa-trash"></i>Delete</button>
      </form>
    </div>
  </div>

  <p class="text-xs text-brand-gray2 mb-4">
    <i class="fa-solid fa-eye"></i> Preview - approximates how this looks on the public landing page. URL slug: <code>/<%= offerRow.slug %></code>
  </p>

  <!-- Preview card, styled to resemble the public landing page's offer card -->
  <div class="card p-6 sm:p-8">
    <% if (offerRow.image_path) { %>
      <img src="<%= offerRow.image_path %>" alt="" class="w-full max-h-64 rounded-lg object-cover mb-4">
    <% } %>
    <div class="flex items-start justify-between gap-4 flex-wrap mb-4">
      <h2 class="text-xl font-bold"><%= offerRow.title %></h2>
      <div class="flex items-center gap-2 flex-wrap">
        <% (offerRow.tags || '').split(',').map(function(t) { return t.trim(); }).filter(Boolean).forEach(function(t) { %>
          <span class="badge-pending !py-1 !px-3"><%= t %></span>
        <% }); %>
      </div>
    </div>

    <% if (offerRow.intro) { %>
      <p class="text-sm text-brand-gray2 mb-6 whitespace-pre-wrap"><%= offerRow.intro %></p>
    <% } %>

    <% if (Array.isArray(offerRow.skills) && offerRow.skills.length > 0) { %>
      <h3 class="text-xs font-bold uppercase tracking-wide text-brand-gray2 mb-3">Skills Required</h3>
      <ul class="space-y-2 mb-6">
        <% offerRow.skills.forEach(function(skill) { %>
          <li class="flex items-start gap-2 text-sm">
            <i class="fa-solid fa-check text-brand-accent mt-0.5"></i>
            <span><%= skill %></span>
          </li>
        <% }); %>
      </ul>
    <% } %>

    <div class="border-t border-brand-borderLight pt-4 flex items-center flex-wrap gap-3 text-sm">
      <span class="btn-primary !cursor-default">Apply <i class="fa-solid fa-arrow-right"></i></span>
      <span class="text-brand-gray2">or send your CV to <a href="mailto:<%= offerRow.apply_email %>" class="text-brand-accent hover:underline"><%= offerRow.apply_email %></a></span>
    </div>
  </div>
    </div>
  </div>
</div>
<script src="/js/confirm-submit.js?v=<%= assetVersion %>" defer></script>

<%- include('../partials/foot') %>
