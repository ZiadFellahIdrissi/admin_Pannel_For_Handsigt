<%- include('../partials/head', { title: chargeRow.category_name }) %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar', { title: chargeRow.category_name }) %>
    <%- include('../partials/flash') %>
    <div class="max-w-5xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
  <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-lg sm:text-xl font-bold flex items-center gap-3">
      <div class="icon-circle-accent"><i class="fa-solid fa-receipt"></i></div>
      <%= chargeRow.category_name %>
    </h1>
    <div class="flex items-center gap-2">
      <a href="/charges" class="btn-secondary"><i class="fa-solid fa-arrow-left"></i>Back</a>
      <a href="/charges/<%= chargeRow.id %>/edit" class="btn-secondary"><i class="fa-solid fa-pen"></i>Edit</a>
      <button type="button" class="btn-secondary" data-dialog-open="upload-invoice">
        <i class="fa-solid fa-upload"></i><%= chargeRow.invoice_path ? 'Replace Invoice' : 'Upload Invoice' %>
      </button>
      <form action="/charges/<%= chargeRow.id %>/delete" method="POST" data-confirm="Delete this charge? This can't be undone.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn-danger"><i class="fa-solid fa-trash"></i>Delete</button>
      </form>
    </div>
  </div>

  <% if (!chargeRow.invoice_path) { %>
    <div class="mb-6 rounded-lg bg-amber-50 dark:bg-amber-950 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300 px-4 py-3 text-sm flex items-start gap-3">
      <i class="fa-solid fa-triangle-exclamation mt-0.5"></i>
      <div><strong>No invoice on file yet.</strong> Upload it once you have it.</div>
    </div>
  <% } %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 items-start">
    <div class="card p-5 sm:p-6">
      <div class="space-y-4 text-sm">
        <div>
          <h2 class="section-title"><i class="fa-solid fa-circle-info"></i>Charge</h2>
          <div class="grid grid-cols-2 gap-x-4 gap-y-2">
            <div><span class="text-brand-gray2">Category</span><br><%= chargeRow.category_name %></div>
            <div><span class="text-brand-gray2">Date</span><br><%= chargeRow.charge_date %></div>
            <div class="col-span-2"><span class="text-brand-gray2">Description</span><br><%= chargeRow.label || '—' %></div>
          </div>
        </div>

        <div>
          <h2 class="section-title"><i class="fa-solid fa-calculator"></i>Amount</h2>
          <div class="grid grid-cols-2 gap-x-4 gap-y-2">
            <div><span class="text-brand-gray2">HT</span><br><%= formatCurrency(chargeRow.amount_ht) %></div>
            <div><span class="text-brand-gray2">TVA</span><br><%= formatCurrency(chargeRow.amount_tva) %></div>
            <div class="col-span-2"><span class="text-brand-gray2">TTC</span><br><span class="font-semibold text-base"><%= formatCurrency(chargeRow.amount_ttc) %></span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: invoice preview -->
    <div class="card p-5 sm:p-6 lg:sticky lg:top-6">
      <h2 class="section-title"><i class="fa-solid fa-file-pdf"></i>Invoice</h2>
      <% if (chargeRow.invoice_path) { %>
        <iframe src="/charges/<%= chargeRow.id %>/pdf" class="w-full rounded-lg border border-brand-borderLight" style="height: 70vh;" title="Invoice"></iframe>
        <a href="/charges/<%= chargeRow.id %>/pdf?download=1" class="btn-secondary w-full mt-3"><i class="fa-solid fa-download"></i>Download</a>
      <% } else { %>
        <p class="text-sm text-brand-gray2">No invoice uploaded yet.</p>
      <% } %>
    </div>
  </div>

  <dialog id="upload-invoice" class="dialog-panel">
    <div class="p-5 sm:p-6">
      <div class="flex items-center justify-between gap-3 mb-4">
        <h3 class="font-bold"><%= chargeRow.invoice_path ? 'Replace Invoice' : 'Upload Invoice' %></h3>
        <button type="button" class="theme-toggle" data-dialog-close aria-label="Close">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <% if (chargeRow.invoice_path) { %>
        <p class="text-sm text-brand-gray2 mb-4">Replaces the current invoice on file. This can't be undone.</p>
      <% } %>
      <form action="/charges/<%= chargeRow.id %>/upload-invoice" method="POST" enctype="multipart/form-data" class="space-y-3" data-prevent-double-submit>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
          <label class="field-label" for="invoice">PDF file</label>
          <input class="field-input" type="file" id="invoice" name="invoice" accept="application/pdf" required>
        </div>
        <button type="submit" class="btn-primary w-full">Upload</button>
      </form>
    </div>
  </dialog>
    </div>
  </div>
</div>
<script src="/js/dialog-toggle.js?v=<%= assetVersion %>" defer></script>
<script src="/js/confirm-submit.js?v=<%= assetVersion %>" defer></script>
<script src="/js/prevent-double-submit.js?v=<%= assetVersion %>" defer></script>

<%- include('../partials/foot') %>
