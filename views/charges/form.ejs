<% var today = new Date().toISOString().slice(0, 10); %>
<%- include('../partials/head', { title: mode === 'create' ? 'New Charge' : 'Edit Charge' }) %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar', { title: mode === 'create' ? 'New Charge' : 'Edit Charge' }) %>
    <%- include('../partials/flash') %>
    <div class="max-w-2xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
<%
  // chargeRow is either null (new form), a raw DB row (snake_case
  // columns, GET edit), or a reconstructed object from a failed
  // validation POST (camelCase-ish keys, matching extractFields in the
  // controller) - same val() convention as views/suppliers/form.ejs.
  function val(camelKey, snakeKey) {
    if (!chargeRow) return '';
    if (chargeRow[camelKey] !== undefined && chargeRow[camelKey] !== null) return chargeRow[camelKey];
    if (chargeRow[snakeKey] !== undefined && chargeRow[snakeKey] !== null) return chargeRow[snakeKey];
    return '';
  }
  var selectedCategoryId = chargeRow ? (chargeRow.categoryId || chargeRow.category_id) : null;
%>
  <h1 class="text-lg sm:text-xl font-bold mb-6 flex items-center gap-3">
    <div class="icon-circle-accent"><i class="fa-solid <%= mode === 'create' ? 'fa-plus' : 'fa-pen' %>"></i></div>
    <%= mode === 'create' ? 'New Charge' : 'Edit Charge' %>
  </h1>

  <% if (errors && errors.length) { %>
    <div class="mb-4 rounded-lg bg-red-50 dark:bg-red-950 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-300 px-4 py-2.5 text-sm space-y-1">
      <% errors.forEach(function(e) { %><div class="flex items-center gap-2"><i class="fa-solid fa-circle-exclamation"></i><%= e %></div><% }); %>
    </div>
  <% } %>

  <form action="<%= mode === 'create' ? '/charges' : '/charges/' + chargeRow.id %>" method="POST" <% if (mode === 'create') { %>enctype="multipart/form-data"<% } %> class="card p-5 sm:p-6 space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div>
      <label class="field-label" for="categoryId">Category</label>
      <select class="field-input" id="categoryId" name="categoryId">
        <option value="">&mdash; Select a category &mdash;</option>
        <% categories.forEach(function(cat) { %>
          <option value="<%= cat.id %>" <%= String(selectedCategoryId) === String(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
        <% }); %>
      </select>
    </div>

    <button type="button" data-collapse-toggle="quick-add-category" aria-expanded="false" class="btn-secondary text-sm">
      <i class="fa-solid fa-chevron-down transition-transform" data-collapse-icon></i>
      Quick-add a new category instead
    </button>

    <div id="quick-add-category" class="hidden">
      <label class="field-label" for="newCategoryName">New category name</label>
      <input class="field-input" type="text" id="newCategoryName" name="newCategoryName" placeholder="e.g. Marketing...">
    </div>

    <div>
      <label class="field-label" for="label">Description (optional)</label>
      <input class="field-input" type="text" id="label" name="label" placeholder="e.g. MacBook Pro for John..." value="<%= val('label', 'label') %>">
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="field-label" for="amount">Amount (MAD)</label>
        <input class="field-input" type="number" step="0.01" min="0" id="amount" name="amount" value="<%= val('amount', 'amount') %>" required>
      </div>
      <div>
        <label class="field-label" for="chargeDate">Date</label>
        <input class="field-input" type="date" id="chargeDate" name="chargeDate" value="<%= mode === 'create' ? (val('chargeDate', 'charge_date') || today) : val('chargeDate', 'charge_date') %>" required>
      </div>
    </div>

    <% if (mode === 'create') { %>
      <div>
        <label class="field-label" for="invoice">Invoice / receipt (optional - can add later too)</label>
        <input class="field-input" type="file" id="invoice" name="invoice" accept="application/pdf">
      </div>
    <% } %>

    <button type="submit" class="btn-primary w-full sm:w-auto">
      <i class="fa-solid fa-check"></i><%= mode === 'create' ? 'Record Charge' : 'Save Changes' %>
    </button>
  </form>
    </div>
  </div>
</div>
<script src="/js/collapse-toggle.js?v=<%= assetVersion %>" defer></script>

<%- include('../partials/foot') %>
