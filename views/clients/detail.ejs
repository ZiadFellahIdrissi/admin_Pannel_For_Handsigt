<%- include('../partials/head', { title: clientRow.name }) %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar', { title: clientRow.name }) %>
    <%- include('../partials/flash') %>
    <div class="max-w-4xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
<% function show(v) { return (v === null || v === undefined || v === '') ? '—' : v; } %>
  <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-lg sm:text-xl font-bold flex items-center gap-3">
      <div class="icon-circle-accent"><i class="fa-solid fa-building"></i></div>
      <span>
        <%= clientRow.name %>
        <span class="ml-2 <%= clientRow.active ? 'badge-approved' : 'badge-draft' %>"><%= clientRow.active ? 'Active' : 'Inactive' %></span>
      </span>
    </h1>
    <a href="/clients/<%= clientRow.id %>/edit" class="btn-secondary">
      <i class="fa-solid fa-pen"></i>Edit
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
    <div class="stat-tile">
      <div class="icon-circle-accent"><i class="fa-solid fa-users"></i></div>
      <div>
        <div class="stat-tile-value"><%= stats.activeConsultantsCount %></div>
        <div class="stat-tile-label">Active Consultants Attached</div>
      </div>
    </div>
    <div class="stat-tile">
      <div class="icon-circle-amber"><i class="fa-solid fa-calendar-day"></i></div>
      <div>
        <div class="stat-tile-value"><%= stats.totalApprovedDays %></div>
        <div class="stat-tile-label">Total Approved Days</div>
      </div>
    </div>
    <div class="stat-tile">
      <div class="icon-circle-emerald"><i class="fa-solid fa-sack-dollar"></i></div>
      <div>
        <div class="stat-tile-value text-base sm:text-xl"><%= formatCurrency(stats.totalApprovedBilled) %></div>
        <div class="stat-tile-label">Total Approved Billed</div>
      </div>
    </div>
  </div>

  <div class="card p-5 sm:p-6 mb-6">
    <div class="space-y-4 text-sm">
      <div>
        <h2 class="section-title"><i class="fa-solid fa-stamp"></i>Enterprise / Legal Identification</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2">
          <div><span class="text-brand-gray2">ICE</span><br><%= show(clientRow.ice) %></div>
          <div><span class="text-brand-gray2">RC</span><br><%= show(clientRow.rc) %></div>
          <div><span class="text-brand-gray2">RC City</span><br><%= show(clientRow.rc_city) %></div>
          <div><span class="text-brand-gray2">Patente</span><br><%= show(clientRow.patente) %></div>
          <div><span class="text-brand-gray2">IF</span><br><%= show(clientRow.tax_identifier) %></div>
          <div><span class="text-brand-gray2">CNSS Number</span><br><%= show(clientRow.cnss_number) %></div>
          <div><span class="text-brand-gray2">Legal Form</span><br><%= show(clientRow.legal_form) %></div>
          <div><span class="text-brand-gray2">Registered Capital</span><br><%= clientRow.registered_capital ? formatCurrency(clientRow.registered_capital) : '—' %></div>
          <div class="col-span-2 sm:col-span-1"><span class="text-brand-gray2">Registered Address</span><br><%= show(clientRow.registered_address) %></div>
        </div>
      </div>

      <div>
        <h2 class="section-title"><i class="fa-solid fa-user-tie"></i>Responsable / Main Contact</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2">
          <div><span class="text-brand-gray2">Name</span><br><%= show(clientRow.contact_name) %></div>
          <div><span class="text-brand-gray2">Title / Role</span><br><%= show(clientRow.contact_title) %></div>
          <div><span class="text-brand-gray2">Phone</span><br><%= show(clientRow.contact_phone) %></div>
          <div><span class="text-brand-gray2">Email</span><br><%= show(clientRow.contact_email) %></div>
        </div>
      </div>

      <div>
        <h2 class="section-title"><i class="fa-solid fa-building-columns"></i>Bank Account Information</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2">
          <div><span class="text-brand-gray2">Bank Name</span><br><%= show(clientRow.bank_name) %></div>
          <div><span class="text-brand-gray2">RIB</span><br><%= show(clientRow.bank_rib) %></div>
          <div><span class="text-brand-gray2">IBAN</span><br><%= show(clientRow.bank_iban) %></div>
          <div><span class="text-brand-gray2">SWIFT / BIC</span><br><%= show(clientRow.bank_swift) %></div>
        </div>
      </div>

      <div>
        <h2 class="section-title"><i class="fa-solid fa-circle-info"></i>General / Other</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2">
          <div><span class="text-brand-gray2">Company Phone</span><br><%= show(clientRow.company_phone) %></div>
          <div><span class="text-brand-gray2">Company Email</span><br><%= show(clientRow.company_email) %></div>
          <div><span class="text-brand-gray2">Website</span><br><%= show(clientRow.website) %></div>
          <div><span class="text-brand-gray2">Payment Terms</span><br><%= show(clientRow.payment_terms) %></div>
          <div class="col-span-2"><span class="text-brand-gray2">Billing Address</span><br><%= show(clientRow.billing_address) %></div>
          <div class="col-span-2"><span class="text-brand-gray2">Notes</span><br><%= show(clientRow.notes) %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="card p-5 sm:p-6 mb-6">
    <h2 class="section-title"><i class="fa-solid fa-users"></i>Attached Consultants</h2>
    <% if (attachedConsultants.length === 0) { %>
      <p class="text-sm text-brand-gray2">No consultants attached yet.</p>
    <% } else { %>
      <div class="space-y-2">
        <% attachedConsultants.forEach(function(c) { %>
          <div class="flex items-center justify-between gap-3 rounded-lg border border-brand-borderLight px-3 py-2 flex-wrap">
            <div>
              <a href="/consultants/<%= c.id %>" class="text-sm font-medium hover:text-brand-accent"><%= c.first_name %> <%= c.last_name %></a>
              <% if (c.role_title) { %><span class="text-brand-gray2 text-sm"> &middot; <%= c.role_title %></span><% } %>
              <% if (!c.active) { %> <span class="badge-draft ml-1">Inactive</span><% } %>
              <div class="text-xs mt-0.5">
                <% if (c.consultant_tjm || c.client_tjm) { %>
                  <span class="text-brand-gray2">Pay: <%= c.consultant_tjm ? formatCurrency(c.consultant_tjm) : '—' %> &middot; Bill: <%= c.client_tjm ? formatCurrency(c.client_tjm) : '—' %></span>
                <% } else { %>
                  <span class="text-amber-600 dark:text-amber-400">Rates not set</span>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <div class="card p-5 sm:p-6">
    <div class="flex items-center justify-between gap-3 mb-3">
      <h2 class="section-title mb-0"><i class="fa-solid fa-clock-rotate-left"></i>Submission History</h2>
      <% if (hasMoreHistory) { %>
        <a href="/history?clientId=<%= clientRow.id %>" class="text-xs font-semibold text-brand-accent">View Full History</a>
      <% } %>
    </div>
    <% if (submissions.length === 0) { %>
      <p class="text-sm text-brand-gray2">No submissions yet.</p>
    <% } else { %>
      <div class="space-y-3">
        <% submissions.forEach(function(s) { %>
          <div class="card-interactive p-4 flex items-center justify-between gap-3 flex-wrap">
            <div class="min-w-0">
              <div class="font-semibold truncate"><%= s.consultant_name %> &middot; <%= monthLabel(s.month) %></div>
              <div class="text-xs text-brand-gray2 mt-0.5">
                <%= s.total_days %> days &middot; Payout <%= formatCurrency(s.total_payout) %>
                <% if (s.total_billed > 0) { %> &middot; Billed <%= formatCurrency(s.total_billed) %><% } %>
              </div>
            </div>
            <span class="badge-<%= s.status %>"><%= s.status.charAt(0).toUpperCase() + s.status.slice(1) %></span>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
