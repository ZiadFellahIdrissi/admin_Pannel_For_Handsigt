<%- include('partials/head', { title: 'Dashboard' }) %>
<div class="flex min-h-screen">
  <%- include('partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('partials/topbar', { title: 'Dashboard' }) %>
    <%- include('partials/flash') %>
    <div class="max-w-6xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
      <h1 class="text-lg sm:text-xl font-bold mb-4 sm:mb-6 flex items-center gap-3">
        <div class="icon-circle-accent"><i class="fa-solid fa-gauge"></i></div>
        Dashboard
      </h1>

      <!-- Revenue (chiffre d'affaires) so far this year vs the same period
           last year - see revenueModel.getYearSummary. Green when ahead,
           red when behind, neutral when last year has nothing to compare. -->
      <%
        var caTrend = revenue.changePct === null ? 'neutral' : (revenue.changePct >= 0 ? 'up' : 'down');
        var caAccent = {
          up: 'border-l-emerald-500',
          down: 'border-l-red-500',
          neutral: 'border-l-slate-300 dark:border-l-slate-600'
        }[caTrend];
        var caPill = {
          up: 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950 dark:text-emerald-300 dark:border-emerald-800',
          down: 'bg-red-50 text-red-700 border-red-200 dark:bg-red-950 dark:text-red-300 dark:border-red-800',
          neutral: 'bg-slate-50 text-slate-600 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700'
        }[caTrend];
        var caBarFill = { up: 'fill-emerald-500', down: 'fill-red-500', neutral: 'fill-brand-accent' }[caTrend];
      %>
      <a href="/finance/revenue" class="card-interactive block p-5 sm:p-6 mb-6 border-l-4 <%= caAccent %>">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="min-w-0">
            <div class="section-title !mb-1"><i class="fa-solid fa-chart-column"></i>Revenue <%= revenue.year %> &middot; Chiffre d'Affaires</div>
            <div class="text-2xl sm:text-3xl font-bold leading-tight"><%= formatCurrency(revenue.total) %></div>
            <div class="text-xs text-brand-gray2 mt-1">
              Invoiced to clients so far this year, excl. VAT<% if (revenue.unpaid > 0) { %> &middot; <%= formatCurrency(revenue.unpaid) %> not yet paid<% } %>
            </div>
          </div>
          <div class="sm:text-right">
            <span class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm font-semibold <%= caPill %>">
              <% if (caTrend === 'neutral') { %>
                No <%= revenue.year - 1 %> revenue <%= revenue.previousTotal > 0 ? 'for this period' : 'to compare' %>
              <% } else { %>
                <i class="fa-solid <%= caTrend === 'up' ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down' %>"></i><%= formatPercentChange(revenue.changePct) %> vs <%= revenue.year - 1 %>
              <% } %>
            </span>
            <% if (caTrend !== 'neutral') { %>
              <div class="text-xs text-brand-gray2 mt-1.5">Same period <%= revenue.year - 1 %>: <%= formatCurrency(revenue.previousComparable) %></div>
            <% } %>
          </div>
        </div>
        <% if (revenue.progressPct !== null) { %>
          <div class="mt-4">
            <div class="h-2 rounded-full overflow-hidden bg-slate-200 dark:bg-slate-700">
              <svg viewBox="0 0 100 1" preserveAspectRatio="none" class="block w-full h-full" aria-hidden="true">
                <rect width="<%= Math.min(100, revenue.progressPct).toFixed(1) %>" height="1" class="<%= caBarFill %>"></rect>
              </svg>
            </div>
            <div class="text-xs text-brand-gray2 mt-1.5">
              <%= Math.round(revenue.progressPct) %>% of <%= revenue.year - 1 %>'s full year (<%= formatCurrency(revenue.previousTotal) %>)<%= revenue.progressPct >= 100 ? ' - already beaten' : '' %>
            </div>
          </div>
        <% } %>
      </a>

      <!-- Needs Attention - action-oriented, not just vanity counts -->
      <h2 class="section-title"><i class="fa-solid fa-triangle-exclamation"></i>Needs Attention</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        <a href="/approvals" class="stat-tile">
          <div class="icon-circle-amber"><i class="fa-solid fa-hourglass-half"></i></div>
          <div>
            <div class="stat-tile-value"><%= pendingCount %></div>
            <div class="stat-tile-label">Pending Submissions</div>
          </div>
        </a>
        <a href="/finance/receivables" class="stat-tile">
          <div class="icon-circle-amber"><i class="fa-solid fa-hand-holding-dollar"></i></div>
          <div>
            <div class="stat-tile-value text-base sm:text-xl"><%= formatCurrency(receivables.total) %></div>
            <div class="stat-tile-label"><%= receivables.rows.length %> unpaid client invoice<%= receivables.rows.length === 1 ? '' : 's' %></div>
          </div>
        </a>
        <a href="/finance/payables" class="stat-tile">
          <div class="icon-circle-amber"><i class="fa-solid fa-money-bill-transfer"></i></div>
          <div>
            <div class="stat-tile-value text-base sm:text-xl"><%= formatCurrency(payables.total) %></div>
            <div class="stat-tile-label"><%= payables.rows.length %> unpaid supplier invoice<%= payables.rows.length === 1 ? '' : 's' %></div>
          </div>
        </a>
        <a href="/salaries" class="stat-tile">
          <div class="<%= employeesNotPaidForPayrollMonth > 0 ? 'icon-circle-amber' : 'icon-circle-emerald' %>"><i class="fa-solid fa-sack-dollar"></i></div>
          <div>
            <div class="stat-tile-value"><%= employeesNotPaidForPayrollMonth %></div>
            <div class="stat-tile-label">Not Yet Paid for <%= payrollMonthLabel %></div>
          </div>
        </a>
      </div>

      <!-- Cash-basis finance snapshot for the current quarter, not just
           month-to-date - see dashboardController.js for why. Same
           rule as the full Finance section either way (see
           financeModel.js): only paid invoices count, each in the month
           of its invoice date. -->
      <h2 class="section-title"><i class="fa-solid fa-coins"></i>This Quarter (<%= quarterLabel %>)</h2>
      <%- include('partials/undatedInvoicesWarning', { undatedInvoices }) %>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6">
        <a href="/finance/pnl" class="stat-tile">
          <div class="icon-circle-emerald"><i class="fa-solid fa-arrow-trend-up"></i></div>
          <div>
            <div class="stat-tile-value text-base sm:text-xl"><%= formatCurrency(pnl.revenueHt) %></div>
            <div class="stat-tile-label">Revenue (HT)</div>
          </div>
        </a>
        <a href="/finance/pnl" class="stat-tile">
          <div class="<%= pnl.netResult >= 0 ? 'icon-circle-emerald' : 'icon-circle-amber' %>"><i class="fa-solid fa-scale-balanced"></i></div>
          <div>
            <div class="stat-tile-value text-base sm:text-xl"><%= formatCurrency(pnl.netResult) %></div>
            <div class="stat-tile-label">Net Result</div>
          </div>
        </a>
        <a href="/finance/tva" class="stat-tile col-span-2 sm:col-span-1">
          <div class="icon-circle-slate"><i class="fa-solid fa-percent"></i></div>
          <div>
            <div class="stat-tile-value text-base sm:text-xl"><%= formatCurrency(tva.net) %></div>
            <div class="stat-tile-label">TVA Nette</div>
          </div>
        </a>
      </div>

      <!-- Module overview - one card per section, each with its own
           headline numbers and a direct link into that module. -->
      <h2 class="section-title"><i class="fa-solid fa-table-cells-large"></i>Overview</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-6">
        <a href="/consultants" class="card-interactive p-4">
          <div class="flex items-center gap-2 mb-3"><div class="icon-circle-accent"><i class="fa-solid fa-users"></i></div><span class="font-semibold">Consultants &amp; CRA</span></div>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div><div class="font-semibold text-base"><%= activeConsultantsCount %></div><div class="text-brand-gray2 text-xs">Active Consultants</div></div>
            <div><div class="font-semibold text-base"><%= formatCurrency(approvedPayoutThisMonth) %></div><div class="text-brand-gray2 text-xs">Approved This Month</div></div>
          </div>
        </a>

        <a href="/clients" class="card-interactive p-4">
          <div class="flex items-center gap-2 mb-3"><div class="icon-circle-accent"><i class="fa-solid fa-building"></i></div><span class="font-semibold">Clients &amp; Suppliers</span></div>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div><div class="font-semibold text-base"><%= activeClientsCount %></div><div class="text-brand-gray2 text-xs">Active Clients</div></div>
            <div><div class="font-semibold text-base"><%= activeSuppliersCount %></div><div class="text-brand-gray2 text-xs">Active Suppliers</div></div>
          </div>
        </a>

        <a href="/candidates" class="card-interactive p-4">
          <div class="flex items-center gap-2 mb-3"><div class="icon-circle-accent"><i class="fa-solid fa-address-card"></i></div><span class="font-semibold">Recruiting</span></div>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div><div class="font-semibold text-base"><%= candidatesTotal %></div><div class="text-brand-gray2 text-xs">Total Candidates</div></div>
            <div><div class="font-semibold text-base"><%= candidatesAddedThisMonth %></div><div class="text-brand-gray2 text-xs">Added This Month</div></div>
            <div><div class="font-semibold text-base"><%= candidatesHiredThisMonth %></div><div class="text-brand-gray2 text-xs">Hired This Month</div></div>
            <div><div class="font-semibold text-base"><%= publishedOffersCount %></div><div class="text-brand-gray2 text-xs">Published Job Offers</div></div>
          </div>
        </a>

        <a href="/finance" class="card-interactive p-4">
          <div class="flex items-center gap-2 mb-3"><div class="icon-circle-accent"><i class="fa-solid fa-coins"></i></div><span class="font-semibold">Finance &amp; Accounting</span></div>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div><div class="font-semibold text-base"><%= formatCurrency(pnl.supplierCostHt) %></div><div class="text-brand-gray2 text-xs">Supplier Cost (HT)</div></div>
            <div><div class="font-semibold text-base"><%= formatCurrency(pnl.chargesHt) %></div><div class="text-brand-gray2 text-xs">Charges (HT)</div></div>
          </div>
        </a>

        <a href="/employees" class="card-interactive p-4">
          <div class="flex items-center gap-2 mb-3"><div class="icon-circle-accent"><i class="fa-solid fa-id-badge"></i></div><span class="font-semibold">Payroll</span></div>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div><div class="font-semibold text-base"><%= activeEmployeesCount %></div><div class="text-brand-gray2 text-xs">Active Employees</div></div>
            <div><div class="font-semibold text-base"><%= employeesPaidForPayrollMonth %> / <%= activeEmployeesCount %></div><div class="text-brand-gray2 text-xs">Paid for <%= payrollMonthLabel %></div></div>
          </div>
        </a>

        <a href="/login-attempts/analysis" class="card-interactive p-4">
          <div class="flex items-center gap-2 mb-3"><div class="icon-circle-accent"><i class="fa-solid fa-shield-halved"></i></div><span class="font-semibold">Security</span></div>
          <div class="text-sm text-brand-gray2">Consultant &amp; admin login activity, analysis</div>
        </a>
      </div>

      <div class="card p-5 sm:p-6">
        <h2 class="section-title"><i class="fa-solid fa-clock-rotate-left"></i>Recent Submissions</h2>

        <% if (recentActivity.length === 0) { %>
          <p class="text-sm text-brand-gray2">Nothing has happened yet.</p>
        <% } else { %>
          <div class="space-y-3">
            <% recentActivity.forEach(function(s) { %>
              <div class="card-interactive p-4 flex items-center justify-between gap-3 flex-wrap">
                <div class="min-w-0">
                  <div class="font-semibold truncate"><%= s.consultant_name %> &middot; <%= monthLabel(s.month) %> &middot; <%= s.client_name %></div>
                  <div class="text-xs text-brand-gray2 mt-0.5"><%= s.total_days %> days &middot; <%= formatCurrency(s.total_payout) %></div>
                </div>
                <span class="badge-<%= s.status %>"><%= s.status.charAt(0).toUpperCase() + s.status.slice(1) %></span>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
