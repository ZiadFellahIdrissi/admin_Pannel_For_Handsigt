<%- include('../partials/head', { title: employeeRow.first_name + ' ' + employeeRow.last_name }) %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar', { title: employeeRow.first_name + ' ' + employeeRow.last_name }) %>
    <%- include('../partials/flash') %>
    <div class="max-w-4xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
<% function show(v) { return (v === null || v === undefined || v === '') ? '—' : v; } %>
  <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-lg sm:text-xl font-bold flex items-center gap-3">
      <div class="icon-circle-accent"><i class="fa-solid fa-id-badge"></i></div>
      <span>
        <%= employeeRow.first_name %> <%= employeeRow.last_name %>
        <span class="ml-2 <%= employeeRow.active ? 'badge-approved' : 'badge-draft' %>"><%= employeeRow.active ? 'Active' : 'Inactive' %></span>
      </span>
    </h1>
    <a href="/employees/<%= employeeRow.id %>/edit" class="btn-secondary">
      <i class="fa-solid fa-pen"></i>Edit
    </a>
  </div>

  <div class="card p-5 sm:p-6 mb-6">
    <div class="space-y-4 text-sm">
      <div>
        <h2 class="section-title"><i class="fa-solid fa-id-badge"></i>Basic Info</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2">
          <div><span class="text-brand-gray2">Job Title</span><br><%= show(employeeRow.job_title) %></div>
          <div><span class="text-brand-gray2">Email</span><br><%= show(employeeRow.email) %></div>
          <div><span class="text-brand-gray2">Phone</span><br><%= show(employeeRow.phone) %></div>
        </div>
      </div>

      <div>
        <h2 class="section-title"><i class="fa-solid fa-sack-dollar"></i>Salary</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2">
          <div><span class="text-brand-gray2">Net Salary</span><br><%= employeeRow.net_salary ? formatCurrency(employeeRow.net_salary) : '—' %></div>
          <div><span class="text-brand-gray2">Gross Salary (Brut)</span><br><%= employeeRow.gross_salary ? formatCurrency(employeeRow.gross_salary) : '—' %></div>
        </div>
      </div>

      <div>
        <h2 class="section-title"><i class="fa-solid fa-building-columns"></i>Bank Account Information</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2">
          <div><span class="text-brand-gray2">Bank Name</span><br><%= show(employeeRow.bank_name) %></div>
          <div><span class="text-brand-gray2">RIB</span><br><%= show(employeeRow.bank_rib) %></div>
          <div><span class="text-brand-gray2">IBAN</span><br><%= show(employeeRow.bank_iban) %></div>
          <div><span class="text-brand-gray2">SWIFT / BIC</span><br><%= show(employeeRow.bank_swift) %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="card p-5 sm:p-6">
    <h2 class="section-title"><i class="fa-solid fa-money-check-dollar"></i>Salary Payments</h2>
    <% if (payments.length === 0) { %>
      <p class="text-sm text-brand-gray2">No salary payments recorded yet - record one from the <a href="/salaries" class="text-brand-accent hover:underline">Salaries</a> page.</p>
    <% } else { %>
      <div class="space-y-3">
        <% payments.forEach(function(p) { %>
          <a href="/salaries/payment/<%= p.id %>" class="card-interactive p-4 flex items-center justify-between gap-3 flex-wrap">
            <div class="min-w-0">
              <div class="font-semibold truncate flex items-center gap-2">
                <%= monthLabel(p.month) %>
                <% if (p.payslip_path) { %><span class="badge-approved !py-0.5 !px-2">Payslip on file</span><% } %>
              </div>
              <div class="text-xs text-brand-gray2 mt-0.5">Paid <%= p.paid_date %></div>
            </div>
            <div class="text-right shrink-0">
              <div class="font-semibold"><%= formatCurrency(p.net_salary) %></div>
              <div class="text-xs text-brand-gray2">Net</div>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
