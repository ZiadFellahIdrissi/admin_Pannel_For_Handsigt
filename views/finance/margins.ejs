<%- include('../partials/head', { title: 'Margins' }) %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar', { title: 'Margins' }) %>
    <%- include('../partials/flash') %>
    <div class="max-w-5xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
  <h1 class="text-lg sm:text-xl font-bold mb-4 sm:mb-6 flex items-center gap-3">
    <div class="icon-circle-accent"><i class="fa-solid fa-scale-balanced"></i></div>
    Margins
  </h1>

  <%- include('../partials/financeNav', { active: 'margins' }) %>
  <%- include('../partials/monthRangeFilter', { actionPath: '/finance/margins', from, to }) %>

  <div class="card p-5 sm:p-6 mb-6">
    <h2 class="section-title"><i class="fa-solid fa-building"></i>By Client</h2>
    <% if (clientMargins.length === 0) { %>
      <p class="text-sm text-brand-gray2">No data in this period.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-brand-gray2 border-b border-brand-borderLight">
            <th class="py-2 pr-3">Client</th>
            <th class="py-2 pr-3 text-right">Revenue (HT)</th>
            <th class="py-2 pr-3 text-right">Supplier Cost (HT)</th>
            <th class="py-2 pr-3 text-right">Margin (HT)</th>
            <th class="py-2 text-right">Margin %</th>
          </tr></thead>
          <tbody>
            <% clientMargins.forEach(function(m) { %>
              <tr class="border-b border-brand-borderLight last:border-0">
                <td class="py-2 pr-3"><a href="/clients/<%= m.clientId %>" class="hover:text-brand-accent font-medium"><%= m.clientName %></a></td>
                <td class="py-2 pr-3 text-right"><%= formatCurrency(m.revenueHt) %></td>
                <td class="py-2 pr-3 text-right"><%= formatCurrency(m.costHt) %></td>
                <td class="py-2 pr-3 text-right font-medium <%= m.marginHt >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400' %>"><%= formatCurrency(m.marginHt) %></td>
                <td class="py-2 text-right"><%= m.marginPct === null ? '—' : m.marginPct.toFixed(1) + '%' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="card p-5 sm:p-6">
    <h2 class="section-title"><i class="fa-solid fa-users"></i>By Consultant</h2>
    <% if (consultantMargins.length === 0) { %>
      <p class="text-sm text-brand-gray2">No data in this period.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left text-brand-gray2 border-b border-brand-borderLight">
            <th class="py-2 pr-3">Consultant</th>
            <th class="py-2 pr-3 text-right">Revenue (HT)</th>
            <th class="py-2 pr-3 text-right">Supplier Cost (HT)</th>
            <th class="py-2 pr-3 text-right">Margin (HT)</th>
            <th class="py-2 text-right">Margin %</th>
          </tr></thead>
          <tbody>
            <% consultantMargins.forEach(function(m) { %>
              <tr class="border-b border-brand-borderLight last:border-0">
                <td class="py-2 pr-3"><a href="/consultants/<%= m.consultantId %>" class="hover:text-brand-accent font-medium"><%= m.consultantName %></a></td>
                <td class="py-2 pr-3 text-right"><%= formatCurrency(m.revenueHt) %></td>
                <td class="py-2 pr-3 text-right"><%= formatCurrency(m.costHt) %></td>
                <td class="py-2 pr-3 text-right font-medium <%= m.marginHt >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400' %>"><%= formatCurrency(m.marginHt) %></td>
                <td class="py-2 text-right"><%= m.marginPct === null ? '—' : m.marginPct.toFixed(1) + '%' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
