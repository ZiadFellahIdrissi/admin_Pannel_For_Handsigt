<%- include('../partials/head', { title: 'Payables' }) %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar', { title: 'Payables' }) %>
    <%- include('../partials/flash') %>
    <div class="max-w-5xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
  <h1 class="text-lg sm:text-xl font-bold mb-4 sm:mb-6 flex items-center gap-3">
    <div class="icon-circle-accent"><i class="fa-solid fa-money-bill-transfer"></i></div>
    Payables
  </h1>

  <%- include('../partials/financeNav', { active: 'payables' }) %>

  <div class="card p-4 mb-6 flex items-center justify-between flex-wrap gap-3">
    <span class="text-sm text-brand-gray2">Real supplier invoices on file, not yet paid - money Handsight owes suppliers</span>
    <span class="text-lg font-bold"><%= formatCurrency(payables.total) %></span>
  </div>

  <% if (payables.rows.length === 0) { %>
    <div class="card p-8 text-center mb-6">
      <i class="fa-regular fa-circle-check text-2xl text-brand-gray2 mb-2"></i>
      <p class="text-sm text-brand-gray2">Nothing outstanding - every real supplier invoice is marked paid.</p>
    </div>
  <% } else { %>
    <div class="space-y-3 mb-6">
      <% payables.rows.forEach(function(inv) { %>
        <a href="/invoices/suppliers/<%= inv.id %>" class="card-interactive p-4 flex items-center justify-between gap-3 flex-wrap">
          <div class="min-w-0">
            <div class="font-semibold truncate"><%= inv.invoice_number %></div>
            <div class="text-xs text-brand-gray2 mt-0.5"><%= inv.supplier_name %> &middot; <%= inv.month ? monthLabel(inv.month) : 'Multiple periods' %></div>
          </div>
          <div class="text-right shrink-0">
            <div class="font-semibold"><%= formatCurrency(inv.total_ttc) %></div>
            <div class="text-xs text-brand-gray2">Since <%= inv.created_at %></div>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>

  <% if (payables.pendingRows.length > 0) { %>
    <div class="card p-4 mb-4 flex items-center justify-between flex-wrap gap-3">
      <span class="text-sm text-brand-gray2">Simulated - not yet a real invoice, not a confirmed debt (for cash-flow planning only)</span>
      <span class="text-lg font-bold text-brand-gray2"><%= formatCurrency(payables.pendingTotal) %></span>
    </div>
    <div class="space-y-3">
      <% payables.pendingRows.forEach(function(inv) { %>
        <a href="/invoices/suppliers/<%= inv.id %>" class="card-interactive p-4 flex items-center justify-between gap-3 flex-wrap opacity-75">
          <div class="min-w-0">
            <div class="font-semibold truncate flex items-center gap-2"><%= inv.invoice_number %><span class="badge-pending !py-0.5 !px-2">Simulation</span></div>
            <div class="text-xs text-brand-gray2 mt-0.5"><%= inv.consultant_name %> &middot; <%= inv.month ? monthLabel(inv.month) : 'Multiple periods' %></div>
          </div>
          <div class="text-right shrink-0">
            <div class="font-semibold"><%= formatCurrency(inv.total_ttc) %></div>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
