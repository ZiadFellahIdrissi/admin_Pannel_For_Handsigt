<%- include('../partials/head', { title: 'Receivables' }) %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar', { title: 'Receivables' }) %>
    <%- include('../partials/flash') %>
    <div class="max-w-5xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
  <h1 class="text-lg sm:text-xl font-bold mb-4 sm:mb-6 flex items-center gap-3">
    <div class="icon-circle-accent"><i class="fa-solid fa-hand-holding-dollar"></i></div>
    Receivables
  </h1>

  <%- include('../partials/financeNav', { active: 'receivables' }) %>

  <div class="card p-4 mb-6 flex items-center justify-between flex-wrap gap-3">
    <span class="text-sm text-brand-gray2">Unpaid client invoices - money clients owe Handsight</span>
    <span class="text-lg font-bold"><%= formatCurrency(receivables.total) %></span>
  </div>

  <% if (receivables.rows.length === 0) { %>
    <div class="card p-8 text-center">
      <i class="fa-regular fa-circle-check text-2xl text-brand-gray2 mb-2"></i>
      <p class="text-sm text-brand-gray2">Nothing outstanding - every client invoice is marked paid.</p>
    </div>
  <% } else { %>
    <div class="space-y-3">
      <% receivables.rows.forEach(function(inv) { %>
        <a href="/invoices/clients/<%= inv.id %>" class="card-interactive p-4 flex items-center justify-between gap-3 flex-wrap">
          <div class="min-w-0">
            <div class="font-semibold truncate"><%= inv.invoice_number %></div>
            <div class="text-xs text-brand-gray2 mt-0.5"><%= inv.client_name %> &middot; <%= inv.month ? monthLabel(inv.month) : 'Multiple periods' %></div>
          </div>
          <div class="text-right shrink-0">
            <div class="font-semibold"><%= formatCurrency(inv.total_ttc) %></div>
            <div class="text-xs text-brand-gray2">Since <%= inv.created_at %></div>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
