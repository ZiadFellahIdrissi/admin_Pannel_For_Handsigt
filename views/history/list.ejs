<%- include('../partials/head', { title: 'History' }) %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar', { title: 'History' }) %>
    <%- include('../partials/flash') %>
    <div class="max-w-4xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
  <h1 class="text-lg sm:text-xl font-bold mb-4 sm:mb-6 flex items-center gap-3">
    <div class="icon-circle-accent"><i class="fa-solid fa-clock-rotate-left"></i></div>
    History
  </h1>

  <form action="/history" method="GET" class="card p-4 mb-6 grid grid-cols-1 sm:grid-cols-4 gap-3 items-end">
    <div>
      <label class="field-label" for="month">Month</label>
      <input class="field-input" type="month" id="month" name="month" value="<%= filters.month %>">
    </div>
    <div>
      <label class="field-label" for="clientId">Client</label>
      <select class="field-input" id="clientId" name="clientId">
        <option value="">All</option>
        <% clients.forEach(function(cl) { %>
          <option value="<%= cl.id %>" <%= String(filters.clientId) === String(cl.id) ? 'selected' : '' %>><%= cl.name %></option>
        <% }); %>
      </select>
    </div>
    <div>
      <label class="field-label" for="status">Status</label>
      <select class="field-input" id="status" name="status">
        <option value="">All</option>
        <% ['draft', 'pending', 'approved', 'rejected'].forEach(function(s) { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
        <% }); %>
      </select>
    </div>
    <button type="submit" class="btn-primary"><i class="fa-solid fa-filter"></i>Filter</button>
  </form>

  <% if (submissions.length === 0) { %>
    <div class="card p-8 text-center">
      <i class="fa-regular fa-folder-open text-2xl text-brand-gray2 mb-2"></i>
      <p class="text-sm text-brand-gray2">No submissions match these filters.</p>
    </div>
  <% } else { %>
    <div class="space-y-3">
      <% submissions.forEach(function(s) { %>
        <% var hasClientInvoice = !!s.client_invoice_id; var hasSupplierInvoice = !!s.supplier_invoice_id; %>
        <div class="card-interactive p-4 flex items-center justify-between gap-3 flex-wrap">
          <div class="min-w-0">
            <div class="font-semibold truncate"><%= s.consultant_name %> &middot; <%= monthLabel(s.month) %> &middot; <%= s.client_name %></div>
            <div class="text-xs text-brand-gray2 mt-0.5">
              <%= s.total_days %> days &middot; Payout <%= formatCurrency(s.total_payout) %>
              <% if (s.total_billed > 0) { %> &middot; Billed <%= formatCurrency(s.total_billed) %> &middot; Margin <%= formatCurrency(s.total_billed - s.total_payout - s.total_fees) %><% } %>
            </div>
            <% if (s.status === 'rejected' && s.admin_comment) { %>
              <div class="text-xs text-red-700 dark:text-red-400 mt-1"><strong>Comment:</strong> <%= s.admin_comment %></div>
            <% } %>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <span class="badge-<%= s.status %>"><%= s.status.charAt(0).toUpperCase() + s.status.slice(1) %></span>
            <% if (s.status === 'approved') { %>
              <% if (hasClientInvoice) { %>
                <a href="/invoices/clients/<%= s.client_invoice_id %>" class="btn-secondary text-xs !px-3 !py-1.5"><i class="fa-solid fa-file-invoice-dollar"></i>Client Invoice</a>
              <% } %>
              <% if (hasSupplierInvoice) { %>
                <a href="/invoices/suppliers/<%= s.supplier_invoice_id %>" class="btn-secondary text-xs !px-3 !py-1.5"><i class="fa-solid fa-file-invoice"></i>Supplier Invoice</a>
              <% } %>
              <% if (!hasClientInvoice || !hasSupplierInvoice) { %>
                <button type="button" class="btn-primary text-xs !px-3 !py-1.5" data-dialog-open="generate-invoice-<%= s.id %>">
                  <i class="fa-solid fa-file-invoice-dollar"></i>Generate Invoice
                </button>
              <% } %>
            <% } %>
            <% if (s.status !== 'draft') { %>
              <form action="/approvals/<%= s.id %>/reopen" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="returnTo" value="/history">
                <button type="submit" class="btn-secondary text-xs !px-3 !py-1.5"><i class="fa-solid fa-rotate-left"></i>Reopen</button>
              </form>
            <% } %>
          </div>
        </div>

        <% if (s.status === 'approved' && (!hasClientInvoice || !hasSupplierInvoice)) { %>
          <dialog id="generate-invoice-<%= s.id %>" class="dialog-panel">
            <div class="p-5 sm:p-6">
              <div class="flex items-center justify-between gap-3 mb-4">
                <h3 class="font-bold">Generate Invoice</h3>
                <button type="button" class="theme-toggle" data-dialog-close aria-label="Close">
                  <i class="fa-solid fa-xmark"></i>
                </button>
              </div>
              <form action="/invoices/generate/<%= s.id %>" method="POST" class="space-y-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% if (!hasClientInvoice && !hasSupplierInvoice) { %>
                  <div class="space-y-2">
                    <label class="option-card">
                      <input type="radio" name="invoiceType" value="both" checked class="accent-brand-accent">
                      <div class="icon-circle-accent !w-9 !h-9 !text-sm shrink-0"><i class="fa-solid fa-layer-group"></i></div>
                      <div class="min-w-0">
                        <div class="font-semibold text-sm">Both invoices</div>
                        <div class="text-xs text-brand-gray2">Client + Supplier, generated together</div>
                      </div>
                    </label>
                    <label class="option-card">
                      <input type="radio" name="invoiceType" value="client" class="accent-brand-accent">
                      <div class="icon-circle-accent !w-9 !h-9 !text-sm shrink-0"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                      <div class="min-w-0">
                        <div class="font-semibold text-sm">Client invoice only</div>
                        <div class="text-xs text-brand-gray2">Bills the client for this submission</div>
                      </div>
                    </label>
                    <label class="option-card">
                      <input type="radio" name="invoiceType" value="supplier" class="accent-brand-accent">
                      <div class="icon-circle-accent !w-9 !h-9 !text-sm shrink-0"><i class="fa-solid fa-file-invoice"></i></div>
                      <div class="min-w-0">
                        <div class="font-semibold text-sm">Supplier invoice only</div>
                        <div class="text-xs text-brand-gray2">Bills Handsight for the consultant's work</div>
                      </div>
                    </label>
                  </div>
                <% } else if (!hasClientInvoice) { %>
                  <input type="hidden" name="invoiceType" value="client">
                  <div class="option-card-static">
                    <div class="icon-circle-accent !w-9 !h-9 !text-sm shrink-0"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                    <div class="min-w-0">
                      <div class="font-semibold text-sm">Client invoice</div>
                      <div class="text-xs text-brand-gray2">The Supplier invoice already exists for this submission</div>
                    </div>
                  </div>
                <% } else { %>
                  <input type="hidden" name="invoiceType" value="supplier">
                  <div class="option-card-static">
                    <div class="icon-circle-accent !w-9 !h-9 !text-sm shrink-0"><i class="fa-solid fa-file-invoice"></i></div>
                    <div class="min-w-0">
                      <div class="font-semibold text-sm">Supplier invoice</div>
                      <div class="text-xs text-brand-gray2">The Client invoice already exists for this submission</div>
                    </div>
                  </div>
                <% } %>
                <button type="submit" class="btn-primary w-full">Generate</button>
              </form>
            </div>
          </dialog>
        <% } %>
      <% }); %>
    </div>
  <% } %>
    </div>
  </div>
</div>
<script src="/js/dialog-toggle.js?v=<%= assetVersion %>" defer></script>

<%- include('../partials/foot') %>
