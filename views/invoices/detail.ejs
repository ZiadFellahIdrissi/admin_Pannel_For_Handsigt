<%
  var isClientType = type === 'client';
  var pageTitle = invoice.invoice_number;
  var listPath = isClientType ? '/invoices/clients' : '/invoices/suppliers';
%>
<%- include('../partials/head', { title: pageTitle }) %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar', { title: pageTitle }) %>
    <%- include('../partials/flash') %>
    <div class="max-w-6xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
  <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-lg sm:text-xl font-bold flex items-center gap-3">
      <div class="icon-circle-accent"><i class="fa-solid fa-file-invoice-dollar"></i></div>
      <%= invoice.invoice_number %>
    </h1>
    <div class="flex items-center gap-2">
      <a href="<%= listPath %>" class="btn-secondary"><i class="fa-solid fa-arrow-left"></i>Back</a>
      <% if (!isClientType) { %>
        <button type="button" class="btn-secondary" data-dialog-open="upload-real-invoice">
          <i class="fa-solid fa-upload"></i>Upload Real Invoice
        </button>
      <% } %>
      <a href="/invoices/<%= invoice.id %>/pdf?download=1" class="btn-primary"><i class="fa-solid fa-download"></i>Download</a>
    </div>
  </div>

  <% if (!isClientType && invoice.is_simulation) { %>
    <div class="mb-6 rounded-lg bg-amber-50 dark:bg-amber-950 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300 px-4 py-3 text-sm flex items-start gap-3">
      <i class="fa-solid fa-triangle-exclamation mt-0.5"></i>
      <div>
        <strong>This is a simulation.</strong> The PDF below is an estimate generated by Handsight, not the official invoice the supplier is supposed to issue. Upload the real one once you receive it.
      </div>
    </div>
  <% } else if (!isClientType) { %>
    <div class="mb-6 rounded-lg bg-emerald-50 dark:bg-emerald-950 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 px-4 py-3 text-sm flex items-start gap-3">
      <i class="fa-solid fa-circle-check mt-0.5"></i>
      <div><strong>Real invoice on file.</strong> The PDF below is the actual document received from the supplier.</div>
    </div>
  <% } %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 items-start">
    <!-- Left: written details -->
    <div class="card p-5 sm:p-6">
      <div class="space-y-4 text-sm">
        <div>
          <h2 class="section-title"><i class="fa-solid fa-circle-info"></i>Invoice</h2>
          <div class="grid grid-cols-2 gap-x-4 gap-y-2">
            <div><span class="text-brand-gray2">Number</span><br><%= invoice.invoice_number %></div>
            <div><span class="text-brand-gray2">Type</span><br><%= isClientType ? 'Client Invoice' : 'Supplier Invoice' %></div>
            <div><span class="text-brand-gray2">Month</span><br><%= monthLabel(invoice.month) %></div>
            <div><span class="text-brand-gray2">Created</span><br><%= invoice.created_at %></div>
          </div>
        </div>

        <div>
          <h2 class="section-title"><i class="fa-solid fa-users"></i>Parties</h2>
          <div class="grid grid-cols-2 gap-x-4 gap-y-2">
            <div><span class="text-brand-gray2">Consultant</span><br><%= invoice.consultant_name %></div>
            <div><span class="text-brand-gray2">Client</span><br><%= invoice.client_name %></div>
          </div>
        </div>

        <div>
          <h2 class="section-title"><i class="fa-solid fa-list"></i>Line Item</h2>
          <p class="mb-2"><%= invoice.label %></p>
          <div class="grid grid-cols-2 gap-x-4 gap-y-2">
            <div><span class="text-brand-gray2">Quantity (days)</span><br><%= invoice.total_days %></div>
            <div><span class="text-brand-gray2">Unit Price (excl. VAT)</span><br><%= formatCurrency(invoice.rate) %></div>
          </div>
        </div>

        <div>
          <h2 class="section-title"><i class="fa-solid fa-calculator"></i>Totals</h2>
          <div class="grid grid-cols-2 gap-x-4 gap-y-2">
            <div><span class="text-brand-gray2">Subtotal (excl. VAT)</span><br><%= formatCurrency(invoice.total_ht) %></div>
            <div><span class="text-brand-gray2">VAT (20%)</span><br><%= formatCurrency(invoice.total_tva) %></div>
            <div class="col-span-2"><span class="text-brand-gray2">Total (incl. VAT)</span><br><span class="font-semibold text-base"><%= formatCurrency(invoice.total_ttc) %></span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: PDF preview -->
    <div class="card p-5 sm:p-6 lg:sticky lg:top-6">
      <h2 class="section-title"><i class="fa-solid fa-file-pdf"></i>PDF</h2>
      <iframe src="/invoices/<%= invoice.id %>/pdf" class="w-full rounded-lg border border-brand-borderLight" style="height: 70vh;" title="Invoice PDF"></iframe>
    </div>
  </div>

  <% if (!isClientType) { %>
    <dialog id="upload-real-invoice" class="dialog-panel">
      <div class="p-5 sm:p-6">
        <div class="flex items-center justify-between gap-3 mb-4">
          <h3 class="font-bold">Upload Real Invoice</h3>
          <button type="button" class="theme-toggle" data-dialog-close aria-label="Close">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
        <p class="text-sm text-brand-gray2 mb-4">Replaces the current PDF with the real invoice you received from the supplier. This can't be undone.</p>
        <form action="/invoices/<%= invoice.id %>/upload-real" method="POST" enctype="multipart/form-data" class="space-y-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div>
            <label class="field-label" for="realInvoice">PDF file</label>
            <input class="field-input" type="file" id="realInvoice" name="realInvoice" accept="application/pdf" required>
          </div>
          <button type="submit" class="btn-primary w-full">Upload</button>
        </form>
      </div>
    </dialog>
  <% } %>
    </div>
  </div>
</div>
<script src="/js/dialog-toggle.js?v=<%= assetVersion %>" defer></script>

<%- include('../partials/foot') %>
