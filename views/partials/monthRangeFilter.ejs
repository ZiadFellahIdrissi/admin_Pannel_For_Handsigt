<%
  // actionPath/from/to are passed in by the including page. A same-month
  // from/to covers a monthly TVA filer; a 3-month span covers a
  // quarterly one - see financeController.js's monthRangeLocals (which
  // is also what persists whichever of these gets picked across the
  // whole Finance section).
  //
  // Quick presets - computed here from the real current date rather than
  // passed in by the controller, since every finance/*.ejs page would
  // otherwise need to duplicate the same date math. Pure display/link
  // generation, no state of its own.
  function pad2(n) { return String(n).padStart(2, '0'); }
  function ym(y, m) { return `${y}-${pad2(m)}`; }
  function quarterRange(y, m) {
    var qStartMonth = Math.floor((m - 1) / 3) * 3 + 1;
    return { from: ym(y, qStartMonth), to: ym(y, qStartMonth + 2) };
  }

  var now = new Date();
  var curY = now.getFullYear();
  var curM = now.getMonth() + 1;

  var lastMonthDate = new Date(curY, curM - 2, 1);
  var lastQuarterAnchor = new Date(curY, curM - 4, 1);
  var thisQuarter = quarterRange(curY, curM);
  var lastQuarter = quarterRange(lastQuarterAnchor.getFullYear(), lastQuarterAnchor.getMonth() + 1);

  var presets = [
    { label: 'This Month', from: ym(curY, curM), to: ym(curY, curM) },
    { label: 'Last Month', from: ym(lastMonthDate.getFullYear(), lastMonthDate.getMonth() + 1), to: ym(lastMonthDate.getFullYear(), lastMonthDate.getMonth() + 1) },
    { label: 'This Quarter', from: thisQuarter.from, to: thisQuarter.to },
    { label: 'Last Quarter', from: lastQuarter.from, to: lastQuarter.to },
    { label: 'This Year', from: ym(curY, 1), to: ym(curY, 12) },
    { label: 'Last Year', from: ym(curY - 1, 1), to: ym(curY - 1, 12) }
  ];
%>
<div class="card p-4 mb-6">
  <form action="<%= actionPath %>" method="GET" class="flex items-end gap-3 flex-wrap mb-3">
    <div>
      <label class="field-label" for="from">From</label>
      <input type="month" name="from" id="from" value="<%= from %>" class="field-input">
    </div>
    <div>
      <label class="field-label" for="to">To</label>
      <input type="month" name="to" id="to" value="<%= to %>" class="field-input">
    </div>
    <button type="submit" class="btn-secondary"><i class="fa-solid fa-filter"></i>Apply</button>
  </form>
  <div class="flex items-center gap-2 flex-wrap">
    <% presets.forEach(function(p) { %>
      <a href="<%= actionPath %>?from=<%= p.from %>&to=<%= p.to %>" class="btn-secondary text-xs <%= (from === p.from && to === p.to) ? '!border-brand-accent !text-brand-accent' : '' %>"><%= p.label %></a>
    <% }); %>
  </div>
</div>
