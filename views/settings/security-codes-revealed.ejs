<%- include('../partials/head', { title: 'Backup Codes' }) %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar', { title: 'Backup Codes' }) %>
    <%- include('../partials/flash') %>
    <div class="max-w-2xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
      <h1 class="text-lg sm:text-xl font-bold mb-6 flex items-center gap-3">
        <div class="icon-circle-accent"><i class="fa-solid fa-key"></i></div>
        Your Backup Codes
      </h1>

      <div class="mb-4 rounded-lg bg-amber-50 dark:bg-amber-950 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300 px-4 py-3 text-sm flex items-start gap-3">
        <i class="fa-solid fa-triangle-exclamation mt-0.5"></i>
        <div>
          <strong>Save these now.</strong> Each code works once, as a way back in if you lose access to your authenticator app. This is the only time they'll be shown - they're not stored anywhere in a readable form after this.
        </div>
      </div>

      <div class="card p-5 sm:p-6 mb-6">
        <div class="grid grid-cols-2 gap-x-6 gap-y-2 font-mono text-sm">
          <% codes.forEach(function(code) { %>
            <div class="px-3 py-2 rounded-lg bg-brand-light dark:bg-brand-darker text-center"><%= code %></div>
          <% }); %>
        </div>
      </div>

      <%
        // Built client-side via a data: URI + the `download` attribute -
        // no server round-trip, and nothing to keep around afterward:
        // this is the only place these codes ever exist in plaintext.
        var txtContent = [
          'Handsight Admin Panel - Two-Factor Backup Codes',
          'Generated: ' + new Date().toISOString().slice(0, 10),
          'Each code works once, as a way back in if you lose access to your authenticator app.',
          ''
        ].concat(codes).join('\n') + '\n';
      %>
      <div class="flex flex-wrap items-center gap-2">
        <a href="data:text/plain;charset=utf-8,<%= encodeURIComponent(txtContent) %>" download="handsight-backup-codes.txt" class="btn-secondary">
          <i class="fa-solid fa-download"></i>Download as .txt
        </a>
        <a href="/settings/security" class="btn-primary">
          <i class="fa-solid fa-check"></i>I've saved these codes
        </a>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
