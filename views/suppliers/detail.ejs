<%- include('../partials/head', { title: supplierRow.legal_name }) %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar', { title: supplierRow.legal_name }) %>
    <%- include('../partials/flash') %>
    <div class="max-w-4xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
<% function show(v) { return (v === null || v === undefined || v === '') ? '—' : v; } %>
  <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
    <h1 class="text-lg sm:text-xl font-bold flex items-center gap-3">
      <div class="icon-circle-accent"><i class="fa-solid fa-industry"></i></div>
      <span>
        <%= supplierRow.legal_name %>
        <span class="ml-2 <%= supplierRow.active ? 'badge-approved' : 'badge-draft' %>"><%= supplierRow.active ? 'Active' : 'Inactive' %></span>
      </span>
    </h1>
    <a href="/suppliers/<%= supplierRow.id %>/edit" class="btn-secondary">
      <i class="fa-solid fa-pen"></i>Edit
    </a>
  </div>

  <div class="card p-5 sm:p-6 mb-6">
    <h2 class="section-title"><i class="fa-solid fa-stamp"></i>Company Identification</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2 text-sm">
      <div><span class="text-brand-gray2">ICE</span><br><%= show(supplierRow.ice) %></div>
      <div><span class="text-brand-gray2">TP</span><br><%= show(supplierRow.tp) %></div>
      <div><span class="text-brand-gray2">IF</span><br><%= show(supplierRow.if_number) %></div>
      <div><span class="text-brand-gray2">RC</span><br><%= show(supplierRow.rc) %></div>
      <div class="col-span-2 sm:col-span-3"><span class="text-brand-gray2">Si&egrave;ge</span><br><%= show(supplierRow.siege) %></div>
    </div>
  </div>

  <div class="card p-5 sm:p-6">
    <h2 class="section-title"><i class="fa-solid fa-file-invoice"></i>Invoices</h2>
    <% if (invoices.length === 0) { %>
      <p class="text-sm text-brand-gray2">No invoices linked to this supplier yet - a supplier gets linked when its real invoice is uploaded on a supplier invoice's page.</p>
    <% } else { %>
      <div class="space-y-3">
        <% invoices.forEach(function(inv) { %>
          <a href="/invoices/suppliers/<%= inv.id %>" class="card-interactive p-4 flex items-center justify-between gap-3 flex-wrap">
            <div class="min-w-0">
              <div class="font-semibold truncate"><%= inv.invoice_number %></div>
              <div class="text-xs text-brand-gray2 mt-0.5"><%= inv.month ? monthLabel(inv.month) : 'Multiple periods' %></div>
            </div>
            <div class="text-right shrink-0">
              <div class="font-semibold"><%= formatCurrency(inv.total_ttc) %></div>
              <div class="text-xs text-brand-gray2">Total incl. VAT</div>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
